# Database URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/talangin_db"

# JWT Secret untuk Autentikasi (Buat string acak yang panjang & aman)
JWT_SECRET="your_super_secret_jwt_key_here_please_change_this"

# Google OAuth Credentials (opsional jika tidak menggunakan Google Login)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
